# User/Group IDs for file ownership (run `id` to find yours)
PUID=1000
PGID=1000

# Timezone (e.g., America/New_York, Europe/London, Asia/Tokyo)
TZ=UTC

# Sync interval in minutes
SYNC_INTERVAL=5

# Path to your local Google Drive sync folder (on host)
LOCAL_PATH=/path/to/gdrive

# Gmail SMTP settings for failure notifications
# Create an App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Email address to receive notifications
NOTIFY_EMAIL=your-email@gmail.com

# Error handling
MAX_FAILURES=10           # Consecutive failures before parking (0=unlimited)
MAX_BACKOFF_MINUTES=60    # Maximum back-off interval

# Percentage of files that may be deleted on one side in a single run before
# bisync aborts. rclone's own default is 50, which is too low to ever rename or
# delete a folder holding more than half your files. Only safe with CHECK_ACCESS.
MAX_DELETE_PERCENT=90

# Require a sentinel file at the ROOT of both sides before syncing. This is a
# narrow guard: it catches the sentinel itself disappearing, not a partial mass
# deletion that leaves it intact. (An entirely empty local folder is already
# caught by rclone's own "empty current Path1 listing" error regardless.)
CHECK_ACCESS=true
CHECK_FILENAME=RCLONE_TEST

# Host path where files deleted or overwritten LOCALLY are kept instead of being
# destroyed. This is the actual safety net for a high MAX_DELETE_PERCENT: files
# rclone removes from Google Drive land in Drive's trash for 30 days, but files
# it removes locally are gone permanently and the loss propagates to every
# Syncthing peer. Must NOT be inside LOCAL_PATH.
BACKUP_PATH=./data/backup
BACKUP_DIR=/backup

# Pass --verbose to rclone (very chatty on large drives)
SYNC_VERBOSE=false

# SMTP endpoint. Only change these to use a provider other than Gmail, or to
# point the notifier at a local server for testing. SMTP_HOST must match the
# host in SMTP_URL, because curl looks up the credentials by hostname.
# SMTP_HOST=smtp.gmail.com
# SMTP_URL=smtps://smtp.gmail.com:465
